---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { ORG, type NavId } from '@/config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ConceptBanner from '@/components/ConceptBanner.astro';
import FloatingActions from '@/components/FloatingActions.astro';
import CartDrawer from '@/components/CartDrawer.astro';
import fontDisplay from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-600-normal.woff2?url';
import fontBody from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  active?: NavId;
  og?: string;           // nombre de la imagen OG en /og/ (sin extensión)
  ogType?: 'website' | 'article' | 'product';
  jsonLd?: object | object[];
  canonical?: string;
  footerNewsletter?: boolean; // false si la página ya tiene su propio formulario de newsletter
}
const { title, description, active = '', og = 'default', ogType = 'website', jsonLd, canonical, footerNewsletter = true } = Astro.props;
const site = Astro.site!;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).href;
const ogImage = new URL(`/og/${og}.png`, site).href;
// Al compartir el enlace (LinkedIn, WhatsApp…) la vista previa debe dejar claro que no es la web oficial
const shareTitle = `Concepto no oficial · ${title}`;
const shareDescription = `Concepto de rediseño no oficial (proyecto de porfolio de María Teresa Barrero). Web oficial: castuo.es. ${description}`;
const lds = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []);
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', site).href,
  name: 'Castuo · Cooperativa del Campo San Pedro',
  url: site.href,
  inLanguage: 'es-ES',
  publisher: { '@id': new URL('/#organization', site).href },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: new URL('/buscar/?q={search_term_string}', site).href },
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      CONCEPTO DE REDISEÑO NO OFICIAL · proyecto de porfolio.
      Este sitio NO debe indexarse ni competir con la web oficial https://castuo.es.
      Por eso todas las páginas llevan noindex/nofollow y robots.txt bloquea el rastreo.
      El resto del SEO on-page (title, description, canónicas, Open Graph, JSON-LD)
      se implementa igualmente como DEMOSTRACIÓN de lo que se haría en producción.
    -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F6F5F0" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Castuo · concepto de rediseño no oficial" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {lds.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header active={active} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer newsletter={footerNewsletter} />
    <FloatingActions showContact={active !== 'contacto'} />
    <ConceptBanner />
    <CartDrawer />
    <div class="sr-only" aria-live="polite" data-live></div>
    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
</style>
