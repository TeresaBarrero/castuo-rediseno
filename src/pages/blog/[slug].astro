---
// /blog/[slug]/ sirve dos tipos de página que comparten nivel de URL:
// · artículos (colección `posts`) → plantilla Article
// · categorías (/blog/del-campo/, /blog/en-la-cocina/…) → Listing con su propio title y description (nota s-bp)
import Article from '@/components/blog/Article.astro';
import Listing from '@/components/blog/Listing.astro';
import { BLOG, CATEGORIES, CAT_IDS, catUrl, getPosts, type CatId, type Post } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  const clash = posts.find((p) => (CAT_IDS as readonly string[]).includes(p.id));
  if (clash) throw new Error(`El slug «${clash.id}» coincide con una categoría del blog`);
  const featured = posts.find((p) => p.data.featured) ?? posts[0];
  return [
    ...posts.map((p) => ({ params: { slug: p.id }, props: { kind: 'post' as const, post: p, all: posts } })),
    ...CAT_IDS.map((c) => {
      const list = posts.filter((p) => p.data.category === c);
      return { params: { slug: c }, props: { kind: 'cat' as const, cat: c, list, all: posts, featuredUrl: featured.url } };
    }),
  ];
}
type P = { kind: 'post'; post: Post; all: Post[] } | { kind: 'cat'; cat: CatId; list: Post[]; all: Post[]; featuredUrl: string };
const props = Astro.props as P;
---
{props.kind === 'post' ? (
  <Article post={props.post} all={props.all} />
) : (
  <Listing title={CATEGORIES[props.cat].title} description={CATEGORIES[props.cat].description} h1={CATEGORIES[props.cat].label}
    eyebrow={BLOG.name} intro={CATEGORIES[props.cat].intro} crumbs={[{ label: 'Blog', href: '/blog/' }, { label: CATEGORIES[props.cat].label }]}
    active={props.cat} posts={props.list.slice(0, BLOG.pageSize)} page={1} totalPages={Math.max(1, Math.ceil(props.list.length / BLOG.pageSize))}
    base={catUrl(props.cat)} featuredUrl={props.featuredUrl} />
)}
