---
// Portada del blog «Cuaderno Castúo» (diseño: BlogPortada.dc.html · SEO: nota s-bp).
import Base from '@/layouts/Base.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import BlogHeader from '@/components/blog/BlogHeader.astro';
import PostCard from '@/components/blog/PostCard.astro';
import AnioCampo from '@/components/blog/AnioCampo.astro';
import CartaCastua from '@/components/blog/CartaCastua.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { BLOG, catLabel, fmtDate, isoDate, getPosts, productCards } from '@/lib/blog';
import { orgId } from '@/lib/schema';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const latest = rest.slice(0, BLOG.pageSize);
const totalPages = Math.max(1, Math.ceil(rest.length / BLOG.pageSize));
const guides = posts.filter((p) => p.data.guide).sort((a, b) => (a.data.guideOrder ?? 99) - (b.data.guideOrder ?? 99)).slice(0, 3);
const recipes = posts.filter((p) => p.data.recipe).slice(0, 3);
// «Desde la tienda»: productos relacionados de los artículos más recientes, sin repetir
const seen = new Set<string>();
const refs = posts.flatMap((p) => p.data.relatedProducts).filter((r) => { const k = `${r.id}|${r.format ?? ''}`; if (seen.has(r.id) || seen.has(k)) return false; seen.add(r.id); seen.add(k); return true; }).slice(0, 4);
const shop = await productCards(refs);

const site = Astro.site!;
const ld = {
  '@context': 'https://schema.org', '@type': 'Blog', '@id': new URL('/blog/#blog', site).href,
  name: BLOG.name, description: BLOG.description, url: new URL('/blog/', site).href, inLanguage: 'es-ES',
  publisher: { '@id': orgId(site) },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: new URL(p.url, site).href, datePublished: isoDate(p.data.pubDate) })),
};
---
<Base title={BLOG.title} description={BLOG.description} active="blog" og="blog" jsonLd={ld} footerNewsletter={false}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`${BLOG.name} (RSS)`} href="/blog/rss.xml" />
  <div data-filter-root data-param="categoria" data-default="todo" data-inline-links>
    <BlogHeader crumbs={[{ label: 'Blog' }]} inline />

    <!-- Destacado -->
    <section class="bf" aria-labelledby="dest" data-filter-hide>
      <div class="wrap bf__g">
        <a href={featured.url} class="bf__img" tabindex="-1" aria-hidden="true">
          <Foto file={featured.data.heroImage} alt="" pos={featured.data.heroPos} crop={1.25} priority height="560px"
            sizes="(max-width: 960px) 100vw, 680px" widths={[400, 600, 800, 1200, 1360]} transitionName={`post-${featured.id}`} />
        </a>
        <div class="bf__txt">
          <p class="eyebrow" style="margin:0">Destacado · {catLabel(featured.data.category)}</p>
          <h2 id="dest" class="bf__t"><a href={featured.url}>{featured.data.title}</a></h2>
          <p class="bf__d">{featured.data.excerpt}</p>
          <div class="author">
            <span class="author__av" aria-hidden="true">C</span>
            <p class="meta"><strong>{BLOG.authorShort}</strong><br /><time datetime={isoDate(featured.data.pubDate)}>{fmtDate(featured.data.pubDate)}</time> · {featured.readingTime} min de lectura</p>
          </div>
          <a href={featured.url} class="btn self-start" aria-label={`Leer el artículo: ${featured.data.title}`}>Leer el artículo <Icon name="arrow" size={18} width={2} class="arrow" /></a>
        </div>
      </div>
    </section>

    <!-- Empieza por aquí -->
    <section class="sec sec--white" aria-labelledby="emp" data-filter-hide>
      <div class="wrap stack" style="gap:40px">
        <div class="sec-head" data-reveal>
          <div class="stack" style="gap:14px"><p class="eyebrow" style="margin:0">Guías básicas</p><h2 id="emp" class="h2">Empieza por aquí</h2></div>
          <p class="head-note">Tres lecturas para entender el aceite de oliva virgen extra antes de comprarlo.</p>
        </div>
        <ol class="guides g3" data-reveal-group>
          {guides.map((g, i) => (
            <li data-reveal>
              <a href={g.url} class="guide">
                <span class="guide__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="guide__t">{g.data.title}</span>
                <span class="meta guide__m">Guía · {g.readingTime} min</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Lo último -->
    <section class="sec ult" aria-labelledby="ult" data-filter-scroll>
      <div class="wrap stack" style="gap:44px">
        <div class="sec-head">
          <div class="stack" style="gap:14px"><p class="eyebrow" style="margin:0" data-filter-title>Todo el cuaderno</p><h2 id="ult" class="h2">Lo último del cuaderno</h2></div>
          <p class="meta" aria-live="polite" data-filter-count data-unit="artículos">{latest.length} artículos</p>
        </div>
        <div class="grid3" data-filter-grid data-reveal-group>
          {rest.map((p, i) => <PostCard post={p} transition filter order={i} extra={i >= BLOG.pageSize} />)}
        </div>
        <p class="empty" data-filter-empty hidden>Pronto publicaremos en esta sección. Mientras tanto, <a href={featured.url}>lee el artículo destacado</a>.</p>
        <div data-filter-hide><Pagination current={1} total={totalPages} base="/blog/" /></div>
      </div>
    </section>
  </div>

  <AnioCampo />

  <!-- Recetas -->
  {recipes.length > 0 && (
    <section class="sec" aria-labelledby="rec">
      <div class="wrap stack" style="gap:40px">
        <div class="sec-head" data-reveal>
          <div class="stack" style="gap:14px"><p class="eyebrow" style="margin:0">En la cocina</p><h2 id="rec" class="h2">Recetas con aceite de aquí</h2></div>
          <a href="/blog/en-la-cocina/" class="lnk">Ver todas las recetas</a>
        </div>
        <div class="grid3" data-reveal-group>
          {recipes.map((p) => <PostCard post={p} variant="recipe" />)}
        </div>
      </div>
    </section>
  )}

  <!-- Desde la tienda -->
  <section class="sec sec--white shop" aria-labelledby="tie">
    <div class="wrap stack" style="gap:32px">
      <div class="sec-head">
        <div class="stack" style="gap:14px"><p class="eyebrow" style="margin:0">Desde la tienda</p><h2 id="tie" class="h2 h2--sm">Lo que usamos en estas recetas</h2></div>
        <a href="/tienda/" class="lnk">Ir a la tienda</a>
      </div>
      <ul class="shop__g" role="list" data-reveal-group>
        {shop.map((c) => (
          <li data-reveal>
            <a href={c.href} class="mini">
              <Foto file={c.img} alt="" fit="contain" sizes="72px" widths={[72, 144]} class="mini__img" />
              <span><span class="mini__n">{c.name}</span><span class="mini__p">{c.priceLabel}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CartaCastua id="nl-blog" />
</Base>

<style>
  .bf[hidden], .sec[hidden], [data-filter-hide][hidden] { display: none; }
  .ult { scroll-margin-top: 24px; }
  .meta { margin: 0; font-size: 13px; color: var(--muted-2); line-height: 1.5; }
  .meta strong { color: var(--ink); }
  .head-note { margin: 0; max-width: 420px; color: var(--muted); line-height: 1.6; }

  .bf { padding: 72px 0 96px; }
  .bf__g { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .bf__img { display: block; border-radius: var(--radius-sm); overflow: hidden; }
  .bf__img :global(img) { transition: transform .9s var(--ease); }
  .bf__g:hover .bf__img :global(img) { transform: scale(1.03); }
  .bf__txt { display: flex; flex-direction: column; gap: 20px; }
  .bf__t { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.08; letter-spacing: -.02em; }
  .bf__t a { color: var(--ink); text-decoration: none; }
  .bf__t a:hover { color: var(--olive); }
  .bf__d { margin: 0; font-size: 18px; line-height: 1.6; color: var(--muted); }
  .author { display: flex; align-items: center; gap: 12px; }
  .author__av { width: 40px; height: 40px; flex: none; border-radius: 50%; background: var(--olive); color: var(--on-dark); display: grid; place-items: center; font-weight: 600; font-size: 14px; }

  .guides { list-style: none; margin: 0; padding: 0; }
  .guide { display: flex; flex-direction: column; gap: 14px; height: 100%; min-height: 260px; padding: 28px; border: 1px solid var(--line); border-radius: 14px; color: var(--ink); text-decoration: none; transition: border-color .25s var(--ease), transform .35s var(--ease); }
  .guide:hover { border-color: var(--ink); color: var(--ink); transform: translateY(-3px); }
  .guide__n { font-family: var(--font-display); font-weight: 600; font-size: 56px; line-height: 1; color: var(--olive); }
  .guide__t { font-family: var(--font-display); font-weight: 600; font-size: 23px; line-height: 1.2; }
  .guide__m { margin-top: auto; }

  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 28px; }
  .empty { margin: 0; padding: 40px; border: 1.5px dashed var(--line-strong); border-radius: var(--radius-md); text-align: center; color: var(--muted); }
  .empty[hidden] { display: none; }

  .shop { padding-block: 88px; }
  .shop__g { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .mini { display: flex; gap: 14px; align-items: center; height: 100%; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius-md); color: var(--ink); text-decoration: none; transition: border-color .25s var(--ease); }
  .mini:hover { border-color: var(--ink); color: var(--ink); }
  .mini :global(.mini__img) { width: 72px; height: 72px; flex: none; border-radius: var(--radius-sm); background: var(--olive-tint); }
  .mini__n { display: block; font-weight: 600; font-size: 15px; line-height: 1.3; }
  .mini__p { display: block; margin-top: 2px; font-family: var(--font-display); font-weight: 600; }

  @media (max-width: 960px) {
    .bf { padding: 48px 0 64px; }
    .bf__g, .grid3 { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .bf__img :global(.media) { height: 300px !important; }
    .guide { min-height: 0; }
    .shop { padding-block: 64px; }
    .shop__g { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
  @media (max-width: 560px) { .shop__g { grid-template-columns: minmax(0, 1fr); } }
</style>
