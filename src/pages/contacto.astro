---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import { ORG } from '@/config';
import { organization, localBusiness } from '@/lib/schema';
const site = Astro.site!;
---
<Base title="Contacto · Cooperativa del Campo San Pedro, Guareña | Castuo"
  description="Dirección, teléfonos y correo de la Cooperativa del Campo San Pedro: Calle Don Benito, 13, 06470 Guareña (Badajoz). Oficinas 924 350 278 · Tienda 687 97 28 77."
  active="contacto" og="contacto" jsonLd={[organization(site), localBusiness(site)]}>
  <section class="kh">
    <div class="wrap stack" style="gap:22px">
      <Breadcrumbs items={[{ label: 'Contacto' }]} />
      <h1 class="h1 h1--page">Contacto</h1>
      <p class="lead" style="max-width:680px">Estamos en Guareña (Badajoz). Llámanos, escríbenos o ven a vernos.</p>
    </div>
  </section>
  <section class="kb" aria-labelledby="con-t">
    <div class="wrap"><ContactBlock /></div>
  </section>
  <section class="kq">
    <div class="wrap g3" data-reveal-group>
      <div class="kc" data-reveal><p class="eyebrow" style="margin:0">Oficinas y socios</p><p class="kc__v"><a href={`tel:${ORG.phoneOffice.tel}`}>{ORG.phoneOffice.display}</a></p><p class="muted">Gestiones de socios, administración, visitas y pedidos de empresa.</p></div>
      <div class="kc" data-reveal><p class="eyebrow" style="margin:0">Tienda online</p><p class="kc__v"><a href={`tel:${ORG.phoneCustomer.tel}`}>{ORG.phoneCustomer.display}</a></p><p class="muted">Atención al cliente: pedidos, envíos y presupuestos fuera de la península.</p></div>
      <div class="kc" data-reveal><p class="eyebrow" style="margin:0">Correo</p><p class="kc__v"><a href={`mailto:${ORG.email}`}>{ORG.email}</a></p><p class="muted">Para cualquier consulta. Te respondemos lo antes posible.</p></div>
    </div>
  </section>
</Base>
<style>
  .kh { padding: 40px 0 56px; }
  .kb { padding: 0 0 72px; }
  .kq { padding: 0 0 112px; }
  .kc { background: var(--surface); border-radius: var(--radius-md); padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .kc__v { font-family: var(--font-display); font-weight: 600; font-size: 26px; letter-spacing: -.02em; }
  .kc__v a { color: var(--ink); text-decoration: none; }
  .kc__v a:hover { color: var(--olive); text-decoration: underline; }
  @media (max-width: 960px) { .kq { padding-bottom: 72px; } }
</style>
