---
// Listado del blog: páginas de categoría (/blog/[categoria]/) y páginas 2+ de la paginación.
// Cada una tiene su propio title, description, canónica y BreadcrumbList.
import Base from '@/layouts/Base.astro';
import BlogHeader from '@/components/blog/BlogHeader.astro';
import PostCard from '@/components/blog/PostCard.astro';
import CartaCastua from '@/components/blog/CartaCastua.astro';
import Pagination from '@/components/blog/Pagination.astro';
import type { Crumb } from '@/components/Breadcrumbs.astro';
import { BLOG, type CatId, type Post } from '@/lib/blog';
interface Props {
  title: string; description: string; h1: string; eyebrow: string; intro: string; crumbs: Crumb[];
  active: CatId | 'todo'; posts: Post[]; page: number; totalPages: number; base: string; featuredUrl: string;
}
const { title, description, h1, eyebrow, intro, crumbs, active, posts, page, totalPages, base, featuredUrl } = Astro.props;
const site = Astro.site!;
const ld = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: h1, description, url: new URL(Astro.url.pathname, site).href, inLanguage: 'es-ES',
  isPartOf: { '@id': new URL('/blog/#blog', site).href },
  mainEntity: { '@type': 'ItemList', itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(p.url, site).href, name: p.data.title })) },
};
---
<Base title={title} description={description} active="blog" og="blog" jsonLd={ld} footerNewsletter={false}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`${BLOG.name} (RSS)`} href="/blog/rss.xml" />
  {page > 1 && <link slot="head" rel="prev" href={page === 2 ? base : `${base}pagina/${page - 1}/`} />}
  {page < totalPages && <link slot="head" rel="next" href={`${base}pagina/${page + 1}/`} />}
  <BlogHeader title={h1} eyebrow={eyebrow} intro={intro} crumbs={crumbs} active={active} />
  <section class="sec" aria-labelledby="ls-t">
    <div class="wrap stack" style="gap:44px">
      <div class="sec-head">
        <h2 id="ls-t" class="h2">{page > 1 ? `Página ${page}` : 'Artículos'}</h2>
        <p class="meta">{posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}</p>
      </div>
      {posts.length > 0 ? (
        <div class="grid3" data-reveal-group>
          {posts.map((p) => <PostCard post={p} transition />)}
        </div>
      ) : (
        <p class="empty">Pronto publicaremos en esta sección. Mientras tanto, <a href={featuredUrl}>lee el artículo destacado</a>.</p>
      )}
      <Pagination current={page} total={totalPages} base={base} />
    </div>
  </section>
  <CartaCastua id="nl-cat" />
</Base>
<style>
  .meta { margin: 0; font-size: 13px; color: var(--muted-2); }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 28px; }
  .empty { margin: 0; padding: 40px; border: 1.5px dashed var(--line-strong); border-radius: var(--radius-md); text-align: center; color: var(--muted); }
  @media (max-width: 960px) { .grid3 { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
</style>
