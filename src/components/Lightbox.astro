---
// Lightbox accesible (<dialog>): flechas, Esc, contador. Las fotos se clonan desde <template>.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { fotoSrc } from '@/lib/images';
interface Props { items: { file: string | null; alt: string }[] }
const { items } = Astro.props;
---
<dialog class="lb" aria-label="Galería de fotos" data-lightbox>
  <div class="lb__in">
    <figure class="lb__fig" data-lb-figure></figure>
    <div class="lb__bar">
      <button type="button" class="lb__b" data-lb-prev aria-label="Foto anterior"><Icon name="chevron" size={22} class="flip" /></button>
      <span class="lb__c" data-lb-count aria-live="polite"></span>
      <button type="button" class="lb__b" data-lb-next aria-label="Foto siguiente"><Icon name="chevron" size={22} /></button>
      <button type="button" class="lb__b" data-lb-close aria-label="Cerrar galería"><Icon name="close" size={22} /></button>
    </div>
  </div>
</dialog>
{items.map((m) => { const s = fotoSrc(m.file); return s && (
  <template data-lb-src><Picture src={s} alt={m.alt} formats={['avif']} fallbackFormat="webp" widths={[800, 1200, Math.min(1600, s.width)]} sizes="90vw" class="lb__img" loading="eager" /></template>
); })}
<style>
  @keyframes xfade { from { opacity: 0; } to { opacity: 1; } }
  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(23, 32, 26, .96); color: var(--on-dark); }
  .lb::backdrop { background: transparent; }
  .lb[open] { animation: xfade .3s var(--ease); }
  .lb__in { height: 100%; display: flex; flex-direction: column; padding: 24px 24px calc(var(--banner-h) + 16px); gap: 16px; }
  .lb__fig { flex: 1; min-height: 0; margin: 0; display: grid; place-items: center; }
  .lb__fig :global(picture), .lb__fig :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: 8px; }
  .lb__fig :global(picture) { display: contents; }
  .lb__bar { display: flex; justify-content: center; align-items: center; gap: 12px; }
  .lb__b { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--dark-line-2); background: transparent; color: var(--on-dark); display: grid; place-items: center; }
  .lb__b:hover { background: var(--dark-surface); }
  .lb__b :global(.flip) { transform: scaleX(-1); }
  .lb__c { min-width: 64px; text-align: center; font-variant-numeric: tabular-nums; color: var(--on-dark-muted); }
</style>
